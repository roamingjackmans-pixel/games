{
  "name": "dungeon-joe",
  "private": true,
  "version": "1.1.0",
  "description": "A browser souls-like: top-down procedurally generated arena rooms, loot, bonfires and four-player online co-op.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-offline.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:data": "vitest run tests/unit/data.test.ts",
    "balance": "vitest run tests/sim/balance.sim.ts --config vitest.sim.config.ts",
    "deploy": "node scripts/deploy-info.mjs"
  },
  "dependencies": {
    "@trystero-p2p/mqtt": "0.26.0",
    "trystero": "0.26.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
